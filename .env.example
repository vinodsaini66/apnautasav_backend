# Application
NODE_ENV=development
PORT=5000
API_VERSION=v1

# Frontend base URL — used to build guest-facing links (e.g. the public
# RSVP link sent via guest compose/send, /weddings/:weddingId/guests/compose)
FRONTEND_URL=http://localhost:3000

# AI Assistant (Phase 9) — POST /weddings/:weddingId/ai/chat.
# Required for that route to work; the rest of the API works without it.
ANTHROPIC_API_KEY=

# Database
MONGODB_URI=mongodb://admin:password123@localhost:27017/wedding_manager?authSource=admin
MONGODB_URI_PROD=mongodb+srv://username:password@cluster.mongodb.net/wedding_manager

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-this-in-production
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d

# OTP
OTP_EXPIRY_MINUTES=10
OTP_LENGTH=6

# Twilio (for SMS)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890

# Redis
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=

# CORS
CORS_ORIGIN=http://localhost:3000,http://localhost:5173
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,https://yourapp.com

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
AUTH_RATE_LIMIT_MAX=5
# Public RSVP form (GET/POST /rsvp/:token) — 15-minute window, see
# rsvpRateLimiter in middleware/rateLimit.middleware.ts
RSVP_RATE_LIMIT_MAX=20

# File Upload
MAX_FILE_SIZE=5242880
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/jpg,application/pdf

# AWS S3 - required for POST /banners/upload (promotional dashboard banners).
# The rest of the API works without these; that one endpoint returns a clear
# "AWS S3 is not configured" error until they're set.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_S3_BUCKET=wedding-manager-uploads

# Logging
LOG_LEVEL=info
LOG_FILE_PATH=logs/

# Email (Optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
EMAIL_FROM=noreply@weddingmanager.com


REDIS_URL=redis://your-redis-url:6379
SOCKET_PING_TIMEOUT=60000
SOCKET_PING_INTERVAL=25000
# Vendor OS (vendor panel — /api/v1/vendor-os). Vendor sessions use their own
# JWT secrets so a family-app token can never open the vendor panel (and vice
# versa). If unset, they are derived from JWT_SECRET/JWT_REFRESH_SECRET with a
# vendor-specific suffix — set real values in production.
VENDOR_JWT_SECRET=change_me_vendor_os_access_secret_min_32_chars
VENDOR_JWT_REFRESH_SECRET=change_me_vendor_os_refresh_secret_min_32_chars
VENDOR_JWT_EXPIRES_IN=1h
VENDOR_JWT_REFRESH_EXPIRES_IN=30d
# Base URL of the Vendor OS / public quote pages — used in shared links
# (quote: <url>/q/<token>, receipt: <url>/r/<token>, profile: <url>/vendors/<slug>).
# Falls back to FRONTEND_URL.
VENDOR_OS_PUBLIC_URL=http://localhost:3000
# Base URL of the Vendor OS panel app — used in auth emails:
# <url>/auth/verify-email?token=…, /auth/email-link?token=…, /auth/reset-password?token=…
# Falls back to VENDOR_OS_PUBLIC_URL. Auth emails need the SMTP_* settings above;
# in development the links are also printed to the server log.
VENDOR_OS_PANEL_URL=http://localhost:3000
